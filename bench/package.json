{
  "name": "ps-spark-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model bench and automated tests for PS Spark (dev-only, not shipped with the plugin)",
  "scripts": {
    "init": "node init.mjs",
    "assets": "node make-assets.mjs",
    "list": "node run.mjs --list",
    "mock": "node run.mjs --mock",
    "test:prompts": "node test-prompts.mjs",
    "test:dev": "node test-dev-ui.cjs",
    "test:bench": "node test-bench.cjs",
    "test:web": "node test-web.mjs",
    "test:pool": "node test-pool.mjs",
    "test": "node test-dev-ui.cjs && node test-comfy.cjs && node test-queue.cjs && node test-scheduler.cjs && node test-bench.cjs && node test-web.mjs && node test-pool.mjs && node test-prompts.mjs",
    "dry": "node run.mjs --config config.json --dry-run",
    "smoke": "node run.mjs --config config.json --cases cutout_basic,erase_object --models 1,2 --repeat 1",
    "bench": "node run.mjs --config config.json",
    "web": "node web-server.mjs --open",
    "retest": "node retest.mjs",
    "test:comfy": "node test-comfy.cjs",
    "test:queue": "node test-queue.cjs",
    "test:scheduler": "node test-scheduler.cjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "jsdom": "^30.1.3"
  }
}
